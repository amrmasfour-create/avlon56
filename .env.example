# Copy to .env and adjust. Real environment variables override this file.
PORT=3000
HOST=0.0.0.0
# Public URL of the site (used for canonical links, sitemap, hreflang)
SITE_URL=https://www.example.com
# SQLite database and upload folder (back both up!)
DB_PATH=./data/app.db
UPLOAD_DIR=./uploads
# First admin account (only used when the users table is empty)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Set to 1 behind HTTPS so session cookies get the Secure flag
SECURE_COOKIES=1
# Set to 1 when running behind a reverse proxy (nginx, Cloudflare) to read X-Forwarded-For
TRUST_PROXY=1
